{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/case/**",
              "components/layout/**",
              "components/media/**",
              "components/type/**",
              "ui_kits/portfolio/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo))/i]",
        "message": "Font not provided by the design system. Available: Archivo."
      },
      {
        "selector": "JSXOpeningElement[name.name='CaseStudyReel'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|poster|caption|key|ref|className|style|children)$/]",
        "message": "<CaseStudyReel> doesn't accept that prop. Declared props: src, poster, caption."
      },
      {
        "selector": "JSXOpeningElement[name.name='ContactLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<ContactLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|size|as|tone|balance|key|ref|className|style|children)$/]",
        "message": "<DisplayTitle> doesn't accept that prop. Declared props: children, size, as, tone, balance."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayTitle'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:ink|on-media)$/]",
        "message": "<DisplayTitle> tone must be one of 'ink' | 'on-media'."
      },
      {
        "selector": "JSXOpeningElement[name.name='IntroBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|discipline|statement|addressedTo|contact|key|ref|className|style|children)$/]",
        "message": "<IntroBlock> doesn't accept that prop. Declared props: name, discipline, statement, addressedTo, contact."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|as|index|key|ref|className|style|children)$/]",
        "message": "<Label> doesn't accept that prop. Declared props: children, tone, as, index."
      },
      {
        "selector": "JSXOpeningElement[name.name='Label'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:quiet|ink|accent|on-media)$/]",
        "message": "<Label> tone must be one of 'quiet' | 'ink' | 'accent' | 'on-media'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MetaItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|value|key|ref|className|style|children)$/]",
        "message": "<MetaItem> doesn't accept that prop. Declared props: key, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='Passage'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|children|lead|key|ref|className|style|children)$/]",
        "message": "<Passage> doesn't accept that prop. Declared props: label, children, lead."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reel'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|poster|caption|fit|full|key|ref|className|style|children)$/]",
        "message": "<Reel> doesn't accept that prop. Declared props: src, poster, caption, fit, full."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reel'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:contain|cover)$/]",
        "message": "<Reel> fit must be one of 'contain' | 'cover'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResultLine'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|label|metric|key|ref|className|style|children)$/]",
        "message": "<ResultLine> doesn't accept that prop. Declared props: children, label, metric."
      },
      {
        "selector": "JSXOpeningElement[name.name='Reveal'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|delay|as|key|ref|className|style|children)$/]",
        "message": "<Reveal> doesn't accept that prop. Declared props: children, delay, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<Rule> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='Rule'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:hairline|strong|accent|on-media)$/]",
        "message": "<Rule> tone must be one of 'hairline' | 'strong' | 'accent' | 'on-media'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|bleed|tight|as|key|ref|className|style|children)$/]",
        "message": "<Section> doesn't accept that prop. Declared props: children, tone, bleed, tight, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='Section'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:page|raised|media)$/]",
        "message": "<Section> tone must be one of 'page' | 'raised' | 'media'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Still'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|caption|ratio|fit|key|ref|className|style|children)$/]",
        "message": "<Still> doesn't accept that prop. Declared props: src, alt, caption, ratio, fit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Still'] > JSXAttribute[name.name='ratio'] > Literal[value!=/^(?:still|reel|wide|square)$/]",
        "message": "<Still> ratio must be one of 'still' | 'reel' | 'wide' | 'square'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Still'] > JSXAttribute[name.name='fit'] > Literal[value!=/^(?:cover|contain)$/]",
        "message": "<Still> fit must be one of 'cover' | 'contain'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StillStripItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|key|ref|className|style|children)$/]",
        "message": "<StillStripItem> doesn't accept that prop. Declared props: src, alt."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
